{% extends 'base.html.twig' %}

{% block body %}

<!-- Page Wrapper -->
<div class="min-h-screen bg-gray-100 flex">

    <!-- Container -->
    <div class="container mx-auto flex items-center justify-center px-4">

        <!-- Card Wrapper -->
        <div class="w-full max-w-md">

            <!-- Card -->
            <div class="bg-white rounded-2xl shadow-lg p-8">

                <!-- Header -->
                <div class="text-center mb-8">
                    <h2 class="text-2xl font-semibold text-gray-800">
                        Create Account
                    </h2>
                    <p class="text-gray-500 text-sm mt-1">
                        Simple and clean registration
                    </p>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                {% if not form.vars.valid %}
                    <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-2 rounded-md text-sm">
                        {{ form_errors(form) }}
                    </div>

                     <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            showToast("Please fix the errors in the form.", "error");
                        });
                    </script>
                {% endif %}

                <!-- Username -->
                <div>
                    {{ form_label(form.username, null, {
                        'label_attr': {'class': 'text-sm text-gray-600'}
                    }) }}

                    {{ form_widget(form.username, {
                        'attr': {
                            'class': 'mt-1 w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none'
                        }
                    }) }}

                    <div class="text-red-500 text-xs mt-1">
                        {{ form_errors(form.username) }}
                    </div>
                </div>

                <!-- Email -->
                <div>
                    {{ form_label(form.email, null, {
                        'label_attr': {'class': 'text-sm text-gray-600'}
                    }) }}

                    {{ form_widget(form.email, {
                        'attr': {
                            'class': 'mt-1 w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none'
                        }
                    }) }}

                    <div class="text-red-500 text-xs mt-1">
                        {{ form_errors(form.email) }}
                    </div>
                </div>

                <!-- Password -->
                <div>
                    {{ form_label(form.password.first, null, {
                        'label_attr': {'class': 'text-sm text-gray-600'}
                    }) }}

                    {{ form_widget(form.password.first, {
                        'attr': {
                            'class': 'mt-1 w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none'
                        }
                    }) }}

                    <div class="text-red-500 text-xs mt-1">
                        {{ form_errors(form.password.first) }}
                    </div>
                </div>

                <!-- Repeat Password -->
                <div>
                    {{ form_label(form.password.second, null, {
                        'label_attr': {'class': 'text-sm text-gray-600'}
                    }) }}

                    {{ form_widget(form.password.second, {
                        'attr': {
                            'class': 'mt-1 w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none'
                        }
                    }) }}

                    <div class="text-red-500 text-xs mt-1">
                        {{ form_errors(form.password.second) }}
                    </div>
                </div>

                <!-- Button -->
                <div class="pt-2">
                    {{ form_widget(form.submit, {
                        'attr': {
                            'class': 'w-full bg-blue-600 text-white py-2 rounded-md hover:bg-blue-700 transition'
                        }
                    }) }}
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {# <script src="{{ asset('js/toast.js') }}"></script> #}

    <script>
        function showToast(message, type = "success") {
            const container = document.getElementById("toast-container");

            const toast = document.createElement("div");
            toast.className = `
                px-4 py-3 rounded-lg shadow-md text-white text-sm
                ${type === "error" ? "bg-red-500" : "bg-green-500"}
                animate-fade-in
            `;
            toast.innerText = message;

            container.appendChild(toast);

            // Auto remove after 3s
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }



        document.addEventListener("DOMContentLoaded", function () {
            let errors = `{{ form_errors(form)|striptags }}`;
            if (errors.trim() !== "") {
                showToast(errors, "error");
            }
        });
    </script>


       

{% endblock %}

{% block stylesheets %}
    <style>
        @keyframes fade-in {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fade-in 0.5s ease-out;
        }
    </style>
{% endblock %}