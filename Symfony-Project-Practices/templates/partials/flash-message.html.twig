<style>
.flash-item {
    transition: all 0.3s ease;
}
</style>
<div class="fixed top-5 right-5 z-50 space-y-3 w-full max-w-sm">

{% for label, messages in app.flashes %}
    {% for message in messages %}

        <div 
            x-data="{ show: true }"
            x-init="setTimeout(() => show = false, 4000)"
            x-show="show"
            x-transition
            class="flex items-start justify-between gap-3 px-4 py-3 rounded-xl shadow-lg border
            {% if label == 'success' %}
                bg-green-100 text-green-800 border-green-300
            {% elseif label == 'error' %}
                bg-red-100 text-red-800 border-red-300
            {% elseif label == 'warning' %}
                bg-yellow-100 text-yellow-800 border-yellow-300
            {% else %}
                bg-blue-100 text-blue-800 border-blue-300
            {% endif %}
            ">

            <div class="text-sm font-medium">
                {{ message }}
            </div>

            <button @click="show = false"
                class="text-lg leading-none font-bold opacity-70 hover:opacity-100">
                ✕
            </button>

        </div>

    {% endfor %}
{% endfor %}

</div>